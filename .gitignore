# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Secrets and credentials ---
.env
.env.*
*.pem
*.key
.aws/

# --- Python (for the AI agent later) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- OS and editor clutter ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Terraform lock file (not committed by choice) ---
.terraform.lock.hcl

# --- Per-environment settings hold no secrets; the pipeline needs them ---
!terraform/site/env/*.tfvars

# --- Identity domain map holds no secrets; it records which names each pipeline may manage ---
!terraform/identity/domains.auto.tfvars
